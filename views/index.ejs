<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>

<main class="container py-5">

    <section class="text-center py-5">
        <h1 class="display-4 fw-bold">CyberTrack</h1>

        <p class="lead mt-3">
            A centralized cybersecurity incident management system
            for reporting and tracking security incidents.
        </p>

        <div class="mt-4">
            <a href="/incident" class="btn btn-dark btn-lg me-2">
                <i class="fa-solid fa-shield-halved"></i>
                Report an Incident
            </a>

            <a href="/dashboard" class="btn btn-outline-dark btn-lg">
                <i class="fa-solid fa-table-list"></i>
                View Incidents
            </a>
        </div>
    </section>

    <section class="row text-center mt-4">

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-file-circle-plus fa-2x mb-3"></i>
                    <h3 class="card-title">Report</h3>
                    <p class="card-text">
                        Submit cybersecurity incidents with important
                        details such as category and severity.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-database fa-2x mb-3"></i>
                    <h3 class="card-title">Track</h3>
                    <p class="card-text">
                        Store reported incidents securely and keep
                        track of their current status.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <i class="fa-solid fa-chart-simple fa-2x mb-3"></i>
                    <h3 class="card-title">Monitor</h3>
                    <p class="card-text">
                        View reported incidents through the CyberTrack
                        incident dashboard.
                    </p>
                </div>
            </div>
        </div>

    </section>

</main>

<%- include partials/footer.ejs %>